          },
          "queryType": "sql",
          "rawSql": "SELECT\n    d.client_latitude AS lat,\n    d.client_longitude AS lon,\n    d.client_ip,\n    COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') AS isp_name,\n    d.client_country_code AS country_name,\n    d.client_city,\n    count() AS total_testes\nFROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\n    AND d.client_latitude IS NOT NULL\n    AND d.client_longitude IS NOT NULL\nGROUP BY d.client_latitude, d.client_longitude, d.client_ip, isp_name, d.client_country_code, d.client_city",
          "refId": "A",
          "selectedFormat": 1
        }
