          },
          "queryType": "sql",
          "rawSql": "SELECT\n    COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') AS provedor,\n    count(DISTINCT d.client_ip) AS total_clientes\nFROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\nGROUP BY provedor\nORDER BY total_clientes DESC\nLIMIT 20",
          "refId": "A",
          "selectedFormat": 1
        }
      ],
      "title": "Clientes por provedor",
      "type": "barchart"
