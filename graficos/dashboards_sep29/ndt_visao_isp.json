          },
          "queryType": "sql",
          "rawSql": "SELECT\n    CAST(s.latitude AS DOUBLE) AS lat,\n    CAST(s.longitude AS DOUBLE) AS lon,\n    s.site AS servidor,\n    s.city AS cidade,\n    s.server_type,\n    CASE\n        WHEN s.site LIKE '%1916' OR s.site LIKE '%2716' OR s.site LIKE '%10881' OR s.site LIKE '%53164' OR s.site LIKE '%53078' OR s.site LIKE '%11242' THEN 'RNP'\n        WHEN s.site LIKE '%15830' THEN 'Equinix'\n        ELSE 'M-Lab'\n    END AS dono\nFROM (SELECT site, latitude, longitude, city, server_type, row_number() OVER (PARTITION BY site ORDER BY update_time DESC) AS rn\n      FROM server WHERE latitude IS NOT NULL AND longitude IS NOT NULL) s\nWHERE s.rn = 1\n    AND s.site IN (\n        SELECT DISTINCT d.server_site\n        FROM download d\n        LEFT JOIN ASNS a ON d.client_asn = a.ASN\n        WHERE $__timeFilter(d.test_time)\n            AND d.client_country_code = 'BR'\n            AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') = '$isp'\n    )",
          "refId": "Servidores",
          "selectedFormat": 1
