          "queryType": "sql",
          "rawSql": "SELECT\n    CAST(avg(d.client_latitude) AS DOUBLE) AS lat,\n    CAST(avg(d.client_longitude) AS DOUBLE) AS lon,\n    d.client_city AS cidade,\n    count() AS total_testes\nFROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND d.client_country_code = 'BR'\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') = '$isp'\n    AND d.client_latitude IS NOT NULL\n    AND d.client_longitude IS NOT NULL\nGROUP BY d.client_city\nORDER BY total_testes DESC\nLIMIT 2000",
