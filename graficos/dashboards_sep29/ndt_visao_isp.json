              "mode": "list",
              "timeField": ""
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT\n    CASE\n        WHEN d.server_site LIKE '%1916' OR d.server_site LIKE '%2716' OR d.server_site LIKE '%10881' OR d.server_site LIKE '%53164' OR d.server_site LIKE '%53078' OR d.server_site LIKE '%11242' THEN 'RNP'\n        WHEN d.server_site LIKE '%15830' THEN 'Equinix'\n        WHEN d.server_site LIKE '%396982' OR d.server_site LIKE 'gru0%' OR d.server_site LIKE 'gru1%' OR d.server_site LIKE 'fln01' OR d.server_site LIKE 'fln0%' OR (length(d.server_site)=5 AND substring(d.server_site,3,1)='0') THEN 'M-Lab'\n        ELSE 'Outros'\n    END AS dono,\n    count() AS testes\nFROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND d.client_country_code = 'BR'\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') = '$isp'\nGROUP BY dono\nORDER BY testes DESC",
          "refId": "A",
          "selectedFormat": 2
        }
      ],
      "title": "ISP × dono do servidor",
      "type": "piechart"
    },
    {
      "datasource": {
        "type": "questdb-questdb-datasource",
        "uid": "dfudvhox4xudce"
      },
      "description": "**O que mede:** % dos testes do ISP que foram para o servidor geograficamente mais próximo (haversine — a mesma fórmula que o Locate do M-Lab usa). Cobre 100% dos testes do ISP no período, sem amostragem.\n\n**Como ler:**\n- 🟢 > 60%: clientes atendidos localmente\n- 🟡 30–60%: intermediário\n- 🔴 < 30%: a maioria do tráfego escapa para servidores distantes\n\n**Por que escapa:** o Locate oferece o servidor mais próximo primeiro, mas cada nó aceita com uma probabilidade própria do cadastro (Probability). Nós de baixa prioridade recusam a maioria das requisições e o teste cai para um servidor mais distante.\n\n**Atenção:** o 'mais próximo' é calculado contra todos os ~260 sites cadastrados (incluindo inativos), então o valor absoluto é subestimado. Use para comparar ISPs entre si (mesmo denominador), não como medida absoluta.",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red"
              },
              {
                "color": "yellow",
                "value": 30
              },
              {
                "color": "green",
                "value": 60
              }
            ]
          },
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 5,
        "w": 6,
        "x": 18,
        "y": 0
      },
      "id": 4,
      "options": {
        "minVizHeight": 75,
        "minVizWidth": 75,
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "showThresholdLabels": true,
        "showThresholdMarkers": true,
        "sizing": "auto"
      },
      "pluginVersion": "12.0.2",
      "targets": [
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "dfudvhox4xudce"
          },
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": "",
              "mode": "list",
              "timeField": ""
            }
          },
          "queryType": "sql",
          "rawSql": "WITH sites AS (\n    SELECT site, latitude, longitude\n    FROM (SELECT site, latitude, longitude, row_number() OVER (PARTITION BY site ORDER BY update_time DESC) AS rn\n          FROM server WHERE latitude IS NOT NULL AND longitude IS NOT NULL)\n    WHERE rn = 1\n),\ncoords AS (\n    SELECT DISTINCT d.client_latitude, d.client_longitude\n    FROM download d\n    LEFT JOIN ASNS a ON d.client_asn = a.ASN\n    WHERE $__timeFilter(d.test_time)\n        AND d.client_country_code = 'BR'\n        AND d.client_latitude IS NOT NULL\n        AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') = '$isp'\n),\ndist AS (\n    SELECT c.client_latitude AS clat, c.client_longitude AS clon, s.site AS mais_proximo,\n        2*6371*asin(sqrt(\n            sin(radians(c.client_latitude - s.latitude)/2)*sin(radians(c.client_latitude - s.latitude)/2)\n            + cos(radians(c.client_latitude))*cos(radians(s.latitude))\n              *sin(radians(c.client_longitude - s.longitude)/2)*sin(radians(c.client_longitude - s.longitude)/2)\n        )) AS dkm\n    FROM coords c CROSS JOIN sites s\n),\nranked AS (\n    SELECT clat, clon, mais_proximo,\n           row_number() OVER (PARTITION BY clat, clon ORDER BY dkm) AS rn\n    FROM dist\n),\nuso AS (\n    SELECT d.client_latitude, d.client_longitude, d.server_site\n    FROM download d\n    LEFT JOIN ASNS a ON d.client_asn = a.ASN\n    WHERE $__timeFilter(d.test_time)\n        AND d.client_country_code = 'BR'\n        AND d.client_latitude IS NOT NULL\n        AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') = '$isp'\n)\nSELECT 100.0 * sum(CASE WHEN u.server_site = r.mais_proximo THEN 1 ELSE 0 END) / count() AS pct_local\nFROM uso u\nJOIN ranked r ON u.client_latitude = r.clat AND u.client_longitude = r.clon\nWHERE r.rn = 1",
          "refId": "A",
          "selectedFormat": 2
        }
      ],
      "title": "Índice de localidade (% no servidor mais próximo)",
      "type": "gauge"
    },
