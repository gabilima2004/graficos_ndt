          },
          "queryType": "sql",
          "rawSql": "SELECT\n    t.client_city AS cidade,\n    max(CASE WHEN t.provedor = 'Claro' THEN t.rtt END) AS claro_rtt,\n    max(CASE WHEN t.provedor = 'Telefônica' THEN t.rtt END) AS telefonica_rtt,\n    max(CASE WHEN t.provedor = 'Gigalink' THEN t.rtt END) AS gigalink_rtt\nFROM (\n    SELECT\n        d.server_site,\n        d.client_city AS client_city,\n        approx_median(d.min_rtt) AS rtt,\n        COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') AS provedor\n    FROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\n    WHERE $__timeFilter(d.test_time)\n        AND d.client_country_code = 'BR'\n        AND d.min_rtt > 0\n        AND d.min_rtt <= 1500000\n        AND d.client_city IS NOT NULL\n        AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\n) t\nWHERE t.server_site IN ($server)\nGROUP BY t.client_city\nORDER BY claro_rtt ASC\nLIMIT 6",
          "refId": "A",
          "selectedFormat": 2
        }
      ],
      "title": "RTT por cidade e provedor",
      "type": "barchart"
