      "targets": [
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "dfudvhox4xudce"
          },
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": "",
              "mode": "list",
              "timeField": ""
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT * FROM (\n    SELECT\n        COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') AS \"Provedor\",\n        count() AS \"Total de Testes\",\n        count(DISTINCT d.client_ip) AS \"Clientes Únicos\",\n        round(avg(d.mean_throughput_mbps), 2) AS \"Média (Mbps)\",\n        approx_median(d.mean_throughput_mbps) AS \"Mediana (Mbps)\",\n        round(min(d.mean_throughput_mbps), 2) AS \"Mínimo (Mbps)\",\n        round(max(d.mean_throughput_mbps), 2) AS \"Máximo (Mbps)\"\n    FROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\n    WHERE $__timeFilter(d.test_time)\n        AND d.mean_throughput_mbps >= 0\n        AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\n        AND d.server_site IN ($server)\n    GROUP BY \"Provedor\"\n\n    UNION ALL\n\n    SELECT\n        '📊 TOTAL GERAL' AS \"Provedor\",\n        count() AS \"Total de Testes\",\n        count(DISTINCT d.client_ip) AS \"Clientes Únicos\",\n        round(avg(d.mean_throughput_mbps), 2) AS \"Média (Mbps)\",\n        approx_median(d.mean_throughput_mbps) AS \"Mediana (Mbps)\",\n        round(min(d.mean_throughput_mbps), 2) AS \"Mínimo (Mbps)\",\n        round(max(d.mean_throughput_mbps), 2) AS \"Máximo (Mbps)\"\n    FROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\n    WHERE $__timeFilter(d.test_time)\n        AND d.mean_throughput_mbps >= 0\n        AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\n        \n) AS resultado\nORDER BY \"Total de Testes\" DESC",
          "refId": "A",
          "selectedFormat": 1
        }
      ],
      "title": "Estatísticas de Download por Provedor",
      "type": "table"
    },
