          "queryType": "sql",
          "rawSql": "SELECT\n    cast(cast(d.test_time as long) / 300000000 * 300000000 as timestamp) AS \"time\",\n    avg(d.min_rtt) AS rtt_ms,\n    COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') AS provedor\nFROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND d.min_rtt >= 0\n    AND d.min_rtt <= 1500000\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\n    AND d.server_site IN ($server)\nGROUP BY \"time\", provedor\nORDER BY \"time\" ASC",
