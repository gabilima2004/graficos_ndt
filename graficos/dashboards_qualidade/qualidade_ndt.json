          },
          "queryType": "sql",
          "rawSql": "SELECT\n    site,\n    tipo_servidor,\n    qualidade,\n    total_testes\nFROM (\nSELECT\n    d.server_site AS site,\n    s.server_type AS tipo_servidor,\n    approx_median(d.min_rtt) AS qualidade,\n    count() AS total_testes\nFROM download d\nJOIN (\n    SELECT site, machine, server_type\n    FROM server LATEST ON update_time PARTITION BY site, machine\n) s ON d.server_site = s.site AND d.server_machine = s.machine\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND d.client_country_code = 'BR'\n    AND d.server_site IN ($server)\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\n    AND d.min_rtt >= 0\n    AND s.server_type IN ('physical', 'virtual')\nGROUP BY site, tipo_servidor\n)\nORDER BY total_testes DESC\nLIMIT 10",
          "refId": "A",
          "selectedFormat": 1
        }
      ],
      "title": "Latência: servidores físicos × virtuais por site",
      "transformations": [
        {
          "id": "groupingToMatrix",
          "options": {
            "columnField": "tipo_servidor",
            "rowField": "site",
            "valueField": "qualidade"
          }
        }
