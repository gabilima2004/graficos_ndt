      "targets": [
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "dfudvhox4xudce"
          },
          "format": 1,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": "",
              "mode": "list",
              "timeField": ""
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT\n    CAST(avg(d.client_latitude) AS DOUBLE) AS lat,\n    CAST(avg(d.client_longitude) AS DOUBLE) AS lon,\n    d.client_city AS cidade,\n    approx_median(d.min_rtt) AS qualidade,\n    count() AS total_testes\nFROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND d.client_country_code = 'BR'\n    AND d.client_city IS NOT NULL\n    AND d.server_site IN ($server)\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\n    AND d.client_latitude IS NOT NULL\n    AND d.client_longitude IS NOT NULL\n    AND d.min_rtt >= 0\nGROUP BY cidade\nLIMIT 2000",
          "refId": "A",
          "selectedFormat": 1
        }
      ],
      "title": "Latência por cidade",
      "type": "geomap"
    },
