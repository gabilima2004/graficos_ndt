          "rawSql": "SELECT\n    d.client_city AS cidade,\n    count() AS total_testes,\n    count(DISTINCT d.client_ip) AS clientes_unicos\nFROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND d.client_country_code = 'BR'\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ('Claro', 'Telefônica', 'Gigalink')\nGROUP BY d.client_city\nORDER BY total_testes DESC\nLIMIT 6",
          "refId": "A",
          "selectedFormat": 2
        }
