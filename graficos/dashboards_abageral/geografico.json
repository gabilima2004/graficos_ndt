          },
          "queryType": "sql",
          "rawSql": "SELECT\n    CAST(avg(d.client_latitude) AS DOUBLE) AS lat,\n    CAST(avg(d.client_longitude) AS DOUBLE) AS lon,\n    d.client_city,\n    d.client_country_code,\n    d.server_site,\n    count() AS total_testes\nFROM download d\nLEFT JOIN ASNS a ON d.client_asn = a.ASN\nWHERE $__timeFilter(d.test_time)\n    AND d.server_site = '$server'\n    AND d.client_country_code = 'BR'\n    AND COALESCE(a.ASN_owner, d.client_asname, 'Desconhecido') IN ($isp)\n    AND d.client_latitude IS NOT NULL\n    AND d.client_longitude IS NOT NULL\nGROUP BY d.client_city, d.client_country_code, d.server_site\nlimit 2000",
          "refId": "Clientes",
          "selectedFormat": 1
        },
        {
          "datasource": {
            "type": "questdb-questdb-datasource",
            "uid": "dfudvhox4xudce"
          },
          "format": 1,
          "hide": false,
          "meta": {
            "builderOptions": {
              "fields": [],
              "limit": "",
              "mode": "list",
              "timeField": ""
            }
          },
          "queryType": "sql",
          "rawSql": "SELECT\n    CAST(latitude AS DOUBLE) AS lat,\n    CAST(longitude AS DOUBLE) AS lon,\n    site AS server_site,\n    city,\n    country_name\nFROM server\nWHERE site = '$server'\n    AND latitude IS NOT NULL\n    AND longitude IS NOT NULL",
          "refId": "Servidores",
          "selectedFormat": 1
        }
      ],
      "title": "Mapa Cliente→Servidor",
